# Copie para docker/.env e preencha os valores obrigatórios locais.
# Use explicitamente: docker compose --env-file docker/.env -f docker/compose.yaml ...
# Precedência: shell > --env-file (substitui docker/.env padrão) > padrão do Compose.
# Obrigatória: chave secreta exclusiva para Django.
SIA_COMPOSE_DJANGO_SECRET_KEY=
# Obrigatória: chave exclusiva para assinatura de JWT.
SIA_COMPOSE_JWT_SIGNING_KEY=
# Obrigatória: senha local do banco Compose.
SIA_COMPOSE_POSTGRES_PASSWORD=
# SIA_COMPOSE_DEMO_PASSWORD=
# SIA_COMPOSE_POSTGRES_DB=sia_compose
# SIA_COMPOSE_POSTGRES_USER=sia_compose
# SIA_COMPOSE_BACKEND_PORT=8100
# SIA_COMPOSE_FRONTEND_PORT=3100
# SIA_COMPOSE_APP_HOST=localhost
# COMPOSE_PROJECT_NAME=sia-dev
