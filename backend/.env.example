# Django
# Gere um valor longo e aleatório para uso local. Nunca reutilize este exemplo.
DJANGO_SECRET_KEY=replace-with-a-local-secret-key
JWT_SIGNING_KEY=replace-with-a-different-local-jwt-signing-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.brs.devtunnels.ms

# PostgreSQL
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Origens do frontend separadas por vírgula
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+-3000\.brs\.devtunnels\.ms$

# Origens autorizadas para formulários protegidos por CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.brs.devtunnels.ms

# Limites dedicados da API pública de inscrição
SIA_PUBLIC_REGISTRATION_READ_RATE=60/minute
SIA_PUBLIC_REGISTRATION_SUBMIT_RATE=10/minute

# Entrega de convites por SMTP. Em desenvolvimento, estes valores apontam
# para uma instância local do Mailpit; ajuste por ambiente sem versionar senha.
SIA_INVITATION_EMAIL_BACKEND=smtp
SIA_SMTP_HOST=127.0.0.1
SIA_SMTP_PORT=1025
SIA_SMTP_USERNAME=
SIA_SMTP_PASSWORD=
SIA_SMTP_FROM_EMAIL=convites@example.test
SIA_SMTP_USE_TLS=False
SIA_SMTP_USE_SSL=False
SIA_SMTP_TIMEOUT=10

# O WhatsApp permanece mock determinístico nesta etapa: sucesso, falha ou timeout.
SIA_WHATSAPP_BACKEND=mock
SIA_WHATSAPP_MOCK_MODE=sucesso

# Celery/Redis: o broker recebe somente IDs técnicos, nunca token ou PII.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
SIA_CELERY_OUTBOX_INTERVAL=300
SIA_CELERY_CAMPAIGN_INTERVAL=300

# Gere uma chave Fernet exclusiva por ambiente, por exemplo com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SIA_INVITATION_OUTBOX_KEY=
SIA_PUBLIC_INVITATION_BASE_URL=http://localhost:3000/convites
