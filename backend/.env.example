# Django
# Gere um valor longo e aleatório para uso local. Nunca reutilize este exemplo.
DJANGO_SECRET_KEY=replace-with-a-local-secret-key
JWT_SIGNING_KEY=replace-with-a-different-local-jwt-signing-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],.brs.devtunnels.ms

# PostgreSQL
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Origens do frontend separadas por vírgula
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+-3000\.brs\.devtunnels\.ms$

# Origens autorizadas para formulários protegidos por CSRF
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.brs.devtunnels.ms
